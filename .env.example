# Supabase (required — create a free project at https://supabase.com)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Everything below is called from the Supabase Edge Functions (server-side),
# NOT from the browser. Set these as Supabase secrets, not here:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxx
#   supabase secrets set OPENWEATHER_API_KEY=xxx
#   supabase secrets set DATA_GOV_IN_API_KEY=xxx
# This file only documents them — the frontend never reads them directly.
# ANTHROPIC_API_KEY=         (Claude / Anthropic Console: https://console.anthropic.com/settings/keys)
# OPENWEATHER_API_KEY=       (https://openweathermap.org/api)
# DATA_GOV_IN_API_KEY=       (Agmarknet mandi prices: https://data.gov.in)
